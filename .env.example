# PostgreSQL (Supabase). Use a connection pooling (porta 6543, pgbouncer) para DATABASE_URL
# e a conexão direta (porta 5432) para DIRECT_URL (usada pelas migrations).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xxxxx.pooler.supabase.com:5432/postgres"

NODE_ENV="production"

# Supabase Storage (anexos de chamados)
SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="xxxxx"
SUPABASE_ANEXOS_BUCKET="chamados-anexos"

# Envio de email (notificação de mudança de status ao solicitante)
# Conta Gmail usada para enviar os emails. Gere uma "Senha de app" em:
# https://myaccount.google.com/apppasswords (requer verificação em duas etapas ativada)
EMAIL_USER=""
EMAIL_PASSWORD=""
# Opcional: nome/endereço exibido como remetente. Se omitido, usa EMAIL_USER.
EMAIL_FROM=""

# URL pública da aplicação, usada para montar o link do chamado no email.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
